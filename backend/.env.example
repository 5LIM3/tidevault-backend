PORT=4000
JWT_SECRET=change-this-to-something-long-and-random
ADMIN_JWT_SECRET=change-this-too-different-from-jwt-secret
ADMIN_PASSWORD=changeme-admin

# App URL used to build links in emails (verification, password reset).
# Local dev: http://localhost:4000
# Once deployed: your Fly.io app URL, e.g. https://tidevault-backend.fly.dev
APP_URL=http://localhost:4000

# Optional — leave unset to have emails logged to the console instead of sent
RESEND_API_KEY=
RESEND_FROM=TideVault <onboarding@resend.dev>

# Leave unset for local dev (uses a SQLite file, tidevault.db, in this folder).
# Set this to your Supabase connection string in production so redeploys
# never wipe real data.
DATABASE_URL=